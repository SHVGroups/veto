# Local development settings for vetod. Copy to server/.env.
# Production deployments set these in their own environment; see
# docs/reference/configuration.md.

VETO_DATABASE_URL=postgres://veto:veto@localhost:5432/veto?sslmode=disable

# Generate with: go run ./cmd/vetod keygen
VETO_MASTER_KEY=

# The console's portless address. Review links and the Origin check use it.
VETO_PUBLIC_URL=https://veto.localhost

# Your TypeSafe API key. Leave empty to have every model-decided call wait for a person.
VETO_JEV_API_KEY=

VETO_LOG_FORMAT=text
VETO_LOG_LEVEL=debug
