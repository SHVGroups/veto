{
  "name": "veto",
  "private": true,
  "description": "Veto: the approval layer between AI agents and the actions they take.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "portless",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "python3 brand/build.py && node brand/export-png.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "portless": "0.15.8",
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  },
  "dependencies": {
    "i": "^0.3.7"
  }
}
