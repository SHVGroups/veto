# Copy to .env and fill in. Keep .env out of version control.

# Password for the bundled PostgreSQL. Use letters and digits only: it is
# placed in a connection URL. openssl rand -hex 24 makes a good one.
POSTGRES_PASSWORD=

# Encrypts stored secrets. Generate with: openssl rand -base64 32
# Losing it makes stored connection, webhook and Slack secrets unreadable.
VETO_MASTER_KEY=

# The https address people use to open the console, such as https://veto.example.com
VETO_PUBLIC_URL=

# Optional. When set, first-run setup asks for it.
VETO_SETUP_TOKEN=

# Your TypeSafe API key. Without it every non-policy call waits for a person.
VETO_JEV_API_KEY=

# Set to false only when testing over plain http on localhost.
VETO_COOKIE_SECURE=true
